{
  "uid": "bouncer-engine",
  "title": "Bouncer Engine",
  "tags": ["bouncer-engine", "authz"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "description": "Authorization decision, latency, and policy-count metrics for the Bouncer Engine ABAC PDP.",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Evaluations / sec (allow vs deny)",
      "datasource": { "type": "prometheus", "uid": "bouncer-prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "tooltip": false, "viz": false, "legend": false }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "allow" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "deny" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (access) (rate(authz_evaluations_total[1m]))",
          "legendFormat": "{{access}}",
          "datasource": { "type": "prometheus", "uid": "bouncer-prometheus" },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Deny ratio (5m)",
      "datasource": { "type": "prometheus", "uid": "bouncer-prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.05, "color": "yellow" },
              { "value": 0.2, "color": "red" }
            ]
          },
          "color": { "mode": "thresholds" },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(authz_evaluations_total{access=\"deny\"}[5m])) / clamp_min(sum(rate(authz_evaluations_total[5m])), 1)",
          "legendFormat": "deny ratio",
          "datasource": { "type": "prometheus", "uid": "bouncer-prometheus" },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Evaluation latency (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "bouncer-prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 5,
            "lineWidth": 2,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "tooltip": false, "viz": false, "legend": false }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p50" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "p95" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          },
          {
            "matcher": { "id": "byName", "options": "p99" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(authz_evaluation_duration_seconds_bucket[5m]))) * 1000",
          "legendFormat": "p50",
          "datasource": { "type": "prometheus", "uid": "bouncer-prometheus" },
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(authz_evaluation_duration_seconds_bucket[5m]))) * 1000",
          "legendFormat": "p95",
          "datasource": { "type": "prometheus", "uid": "bouncer-prometheus" },
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(authz_evaluation_duration_seconds_bucket[5m]))) * 1000",
          "legendFormat": "p99",
          "datasource": { "type": "prometheus", "uid": "bouncer-prometheus" },
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active policies",
      "datasource": { "type": "prometheus", "uid": "bouncer-prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "blue" }
            ]
          },
          "color": { "mode": "thresholds" },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "authz_policy_count",
          "legendFormat": "policies",
          "datasource": { "type": "prometheus", "uid": "bouncer-prometheus" },
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    }
  ]
}
